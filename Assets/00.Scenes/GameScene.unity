      m_Calls: []
  m_text: "\uAC8C\uC784 \uBAA9\uD45C: 30\uC77C\uAE4C\uC9C0 \uBA54\uC778\uC131\uC744
    \uC9C0\uD0A4\uC2ED\uC2DC\uC624 \n         \u3134  \uB9CC\uC57D \uBA54\uC778\uC131\uC774
    \uBD80\uC154\uC9C0\uAC8C \uB418\uBA74 \uAC8C\uC784\uC774 \uD328\uBC30\uD558\uAC8C
    \uB429\uB2C8\uB2E4\n\n\uC790\uC6D0: \uD074\uB9AD, \uB098\uBB34, \uB3CC \uACE8\uB4DC\uAC00
    \uC874\uC7AC \uD569\uB2C8\uB2E4\n\u3134 \uD074\uB9AD: \uCC98\uC74C\uC5D0 \uCD5C\uB300
    40 / \uD558\uB8E8\uB9C8\uB2E4 10\uC529 \uCDA9\uC804 \uB418\uB294 \uC7AC\uD654\uC774\uBA70
    \uC548\uAC1C\uB97C \uD074\uB9AD\uD558\uC5EC \uB9F5\uC744 \uBC1D\uD788\uAC70\uB098
    \uB098\uBB34 & \uB3CC\uC744 \uD074\uB9AD\uD558\uC5EC \uC790\uC6D0\uC744 \uC5BB\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4 \n(\uAC74\uBB3C\uB85C \uCD5C\uB300\uCE58, \uD558\uB8E8\uC5D0
    \uCDA9\uC804\uB418\uB294 \uC591\uC744 \uB298\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4
    )\n\n\u3134 \uB098\uBB34 & \uB3CC: \uAC74\uBB3C\uC744 \uC124\uCE58 \uD560 \uB54C
    \uC0AC\uC6A9\uB418\uB294 \uC790\uC6D0 \uC785\uB2C8\uB2E4\n\u3134 \uACE8\uB4DC:
    \uBAAC\uC2A4\uD130 \uCC98\uC9C0 or Wave \uD074\uB9AC\uC5B4 \uC2DC \uC5BB\uAC8C
    \uB418\uACE0 \uAC74\uBB3C \uD574\uAE08\uC5D0 \uC0AC\uC6A9\uC774 \uB429\uB2C8\uB2E4
    \n"
