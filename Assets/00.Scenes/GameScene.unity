  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB0A0\uC528: \uB0A0\uC528\uB294 \uCD1D \uB9D1\uC74C, \uBE44, \uD3ED\uD48D\uC6B0,
    \uB208 \uC774 \uC788\uC2B5\uB2C8\uB2E4\n \u3134 \uBE44: \uBE44 \uB0A0\uC528\uB294
    \uD074\uB9AD\uD558\uC5EC \uC5BB\uB294 \uC790\uC6D0\uC758 \uB7C9\uC744 2\uBC30\uB85C
    \uC5BB\uAC8C \uD574\uC90D\uB2C8\uB2E4 \n \u3134 \uD3ED\uD48D\uC6B0: \uB9F5\uC5D0
    \uBC88\uAC1C\uAC00 \uCCD0 \uC8FC\uBCC0\uC5D0 \uC788\uB294 \uAC74\uBB3C or \uC801\uC744
    \uACF5\uACA9\uD569\uB2C8\uB2E4 \n \u3134 \uB208: \uAC74\uBB3C\uC758 \uACF5\uACA9\uC18D\uB3C4
    and \uACF5\uACA9\uB825\uC744 \uAC10\uC18C \uC2DC\uD0B5\uB2C8\uB2E4\n \u3134 \uAC74\uBB3C
    \uC911 \uD654\uB85C\uB97C \uC124\uCE58\uD558\uC5EC \uB208\uC758 \uB514\uBC84\uD504\uB97C
    \uB9C9\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4 \n \u3134 1~10\uC77C \uB9D1\uC74Cor\uBE44
    / 11~20\uC77C \uB9D1\uC74Cor\uBE44or\uD3ED\uD48D\uC6B0 / 21~30\uC77C \uB208\n\uC774\uB807\uAC8C
    \uB0A0\uC528\uAC00 \uB098\uC635\uB2C8\uB2E4 \n"
